# Base URL of the FanFlow backend API
VITE_API_URL="http://localhost:5050"

# OIDC provider settings — defaults to the local fake-oidc container (see docker-compose.yaml).
# Requires "127.0.0.1 fake-oidc" in your hosts file. Always logs in as the "admin" user.
# For staging/production these are overridden at build time by CI (see frontend-deploy.yml).
VITE_OIDC_AUTHORITY="http://fake-oidc:5000"
VITE_OIDC_CLIENT_ID="frontend"
