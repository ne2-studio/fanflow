server {
    listen 80;
    server_name _;

    # Docker embedded DNS.
    # Nginx volverá a resolver los hostnames cada 10 segundos.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # Tracking beacons embedded in the static landing pages (/pv, /out, /trap)
    # are proxied straight through to the backend API.
    location ~ ^/(pv|out|trap)/ {
        set $backend_upstream http://${BACKEND_HOST};

        proxy_pass $backend_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else is a release slug: proxy straight to the MinIO object for that slug.
    location / {
        rewrite ^/([^/.]+)$ /${MINIO_BUCKET}/$1.html break;
        rewrite ^/(.*)$ /${MINIO_BUCKET}/$1 break;

        proxy_pass http://${MINIO_ENDPOINT};
    }
}